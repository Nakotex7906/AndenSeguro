# === Cámara Ezviz ===
APP_KEY=your_app_key
APP_SECRET=your_app_secret
SERIAL=your_camera_serial
BASE_URL=https://isaopen.ezvizlife.com/

# === Debug ===
USE_MOCK_CAMERA=False
DEBUG_POSE=False
DEBUG_STREAM_URL=

# === Modelo de IA ===
YOLO_MODEL=yolov8m-pose.pt
YOLO_IMGSZ=1280
YOLO_CONF_THRESHOLD=0.30

# === Base de Datos (PostgreSQL via Docker) ===
DATABASE_URL=postgresql://anden_user:anden_pass@localhost:5432/anden_seguro_db

# === Seguridad / JWT ===
SECRET_KEY=change-me-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Riesgo ===
LOITERING_THRESHOLD_SECONDS=5.0

# === CORS ===
FRONTEND_URL=http://localhost:5173
